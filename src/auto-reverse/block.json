{
    "apiVersion": 2,
    "name": "create-block/auto-reverse",
    "version": "0.1.0",
    "title": "Bloc de texte inversible",
    "category": "widgets",
    "icon": "smiley",
    "description": "Un bloc qui inverse le texte quand on clique dessus",
    "supports": {
        "html": false
    },
    "textdomain": "auto-reverse",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./frontend.js",
    "attributes": {
        "content": {
            "type": "string",
            "default": "Hello World"
        },
        "backgroundColor": {
            "type": "string",
            "default": "#000000"
        },
        "borderColor": {
            "type": "string",
            "default": "#000000"
        }
    }
}